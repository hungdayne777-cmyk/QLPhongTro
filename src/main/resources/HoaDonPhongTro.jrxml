<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="HoaDonPhongTro" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    
    <!-- 1. Tham số truyền từ Java -->
    <parameter name="MaHoaDon" class="java.lang.String"/>

    <!-- 2. Truy vấn dữ liệu liên kết HOADON -> HOPDONG -> NGUOITHUE -->
    <queryString>
        <![CDATA[
            SELECT 
                h.*, 
                nt.HoTen AS TenKhachHang,
                ABS(h.CSDienMoi - h.CSDienCu) * h.DonGiaDien AS TienDien, 
                ABS(h.CSNuocMoi - h.CSNuocCu) * h.DonGiaNuoc AS TienNuoc 
            FROM HOADON h
            LEFT JOIN HOPDONG hd ON h.MaHD = hd.MaHD
            LEFT JOIN NGUOITHUE nt ON hd.MaNT = nt.MaNT
            WHERE h.MaHoaDon = $P{MaHoaDon}
        ]]>
    </queryString>

    <!-- 3. Khai báo các Field đúng với CSDL -->
    <field name="MaHoaDon" class="java.lang.String"/>
    <field name="TenKhachHang" class="java.lang.String"/>
    <field name="TrangThaiThanhToan" class="java.lang.String"/>
    <field name="CSDienCu" class="java.lang.Double"/>
    <field name="CSDienMoi" class="java.lang.Double"/>
    <field name="DonGiaDien" class="java.lang.Double"/>
    <field name="CSNuocCu" class="java.lang.Double"/>
    <field name="CSNuocMoi" class="java.lang.Double"/>
    <field name="DonGiaNuoc" class="java.lang.Double"/>
    <field name="TienPhong" class="java.lang.Double"/>
    <field name="TienDien" class="java.lang.Double"/>
    <field name="TienNuoc" class="java.lang.Double"/>
    <field name="TongTien" class="java.lang.Double"/>

    <!-- 4. Tiêu đề Hóa Đơn -->
    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[HÓA ĐƠN THANH TOÁN PHÒNG TRỌ]]></text>
            </staticText>
        </band>
    </title>

    <!-- 5. Chi tiết nội dung Hóa Đơn -->
    <detail>
        <band height="380">
            <!-- Mã Hóa Đơn -->
            <staticText>
                <reportElement x="30" y="10" width="120" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Mã Hóa Đơn:]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="10" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{MaHoaDon}]]></textFieldExpression>
            </textField>

            <!-- Khách Thuê -->
            <staticText>
                <reportElement x="30" y="35" width="120" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Khách Thuê:]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="35" width="200" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{TenKhachHang} != null ? $F{TenKhachHang} : "Chưa cập nhật"]]></textFieldExpression>
            </textField>

            <!-- Trạng Thái Thanh Toán -->
            <staticText>
                <reportElement x="30" y="60" width="120" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Trạng Thái:]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="60" width="200" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{TrangThaiThanhToan} != null ? $F{TrangThaiThanhToan} : "Chưa thanh toán"]]></textFieldExpression>
            </textField>

            <!-- Đường kẻ xám nhạt -->
            <line>
                <reportElement x="30" y="90" width="495" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </graphicElement>
            </line>

            <!-- Tiền Phòng -->
            <staticText>
                <reportElement x="30" y="100" width="120" height="20"/>
                <text><![CDATA[Tiền Phòng:]]></text>
            </staticText>
            <textField pattern="#,##0 VNĐ">
                <reportElement x="160" y="100" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{TienPhong}]]></textFieldExpression>
            </textField>

            <!-- Tiền Điện -->
            <staticText>
                <reportElement x="30" y="130" width="120" height="20"/>
                <text><![CDATA[Tiền Điện:]]></text>
            </staticText>
            <textField pattern="#,##0 VNĐ">
                <reportElement x="160" y="130" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{TienDien}]]></textFieldExpression>
            </textField>

            <!-- Tiền Nước -->
            <staticText>
                <reportElement x="30" y="160" width="120" height="20"/>
                <text><![CDATA[Tiền Nước:]]></text>
            </staticText>
            <textField pattern="#,##0 VNĐ">
                <reportElement x="160" y="160" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{TienNuoc}]]></textFieldExpression>
            </textField>

            <!-- Đường kẻ nét đứt -->
            <line>
                <reportElement x="30" y="195" width="495" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0" lineStyle="Dashed" lineColor="#000000"/>
                </graphicElement>
            </line>

            <!-- TỔNG TIỀN -->
            <staticText>
                <reportElement x="30" y="210" width="120" height="25"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[TỔNG TIỀN:]]></text>
            </staticText>
            <textField pattern="#,##0 VNĐ">
                <reportElement x="160" y="210" width="200" height="25"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{TongTien}]]></textFieldExpression>
            </textField>

            <!-- Đường kẻ đậm chốt hóa đơn -->
            <line>
                <reportElement x="30" y="245" width="495" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.5" lineColor="#000000"/>
                </graphicElement>
            </line>

            <!-- THỜI GIAN IN HÓA ĐƠN VÀ CHỮ KÝ -->
            <!-- Ngày giờ in tự động -->
            <staticText>
                <reportElement x="300" y="260" width="70" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isItalic="true"/>
                </textElement>
                <text><![CDATA[Ngày in: ]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm:ss">
                <reportElement x="370" y="260" width="155" height="20"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>

            <!-- Khu vực ký tên -->
            <staticText>
                <reportElement x="350" y="285" width="175" height="20"/>
                <textElement textAlignment="Center">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Người lập hóa đơn]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="305" width="175" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[(Ký, ghi rõ họ tên)]]></text>
            </staticText>
        </band>
    </detail>
</jasperReport>